{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sudoprivacy/sudograph/schema/spec.schema.json",
  "title": "sudograph spec",
  "description": "Field names are English because they are the contract. Values keep the customer's own business vocabulary.",
  "type": "object",
  "required": [
    "ontology",
    "types"
  ],
  "additionalProperties": false,
  "properties": {
    "ontology": {
      "type": "string",
      "minLength": 1
    },
    "bases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 2,
      "uniqueItems": true,
      "description": "Named readings the same structure is computed under — the book figures, the restated ones, the tax ones. A flat list, not a product of dimensions: two rule axes would give 2^n complete alternative worlds and n(n-1)/2 bridges between them, and the business names its readings rather than crossing them. A node writes op@<reading> only where the readings genuinely differ; everything else stays single-sourced."
    },
    "bridges": {
      "type": "object",
      "description": "Which pairs of readings produce adjusting entries. Required once more than two readings are declared: past two, 'the difference' is no longer a single thing, and an undeclared bridge is a deliverable nobody agreed to produce. One pair, one bridge.",
      "additionalProperties": {
        "type": "object",
        "required": [
          "from",
          "to"
        ],
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "types": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/type"
      }
    },
    "raw": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/raw"
      }
    },
    "hooks": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/hook"
      }
    },
    "instances": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object"
        }
      }
    },
    "nodes": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/node"
      }
    },
    "ops": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/op"
      }
    },
    "checks": {
      "type": "object",
      "description": "Articulation assertions — the unit tier. Pure computation over node values, run on every compile. There is no separate reconciliation script by design: if a check ran against anything else, the two could disagree.",
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string",
            "description": "Must hold in every period."
          },
          {
            "type": "object",
            "required": [
              "expr"
            ],
            "additionalProperties": false,
            "properties": {
              "expr": {
                "type": "string"
              },
              "period": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Scoped by the key's presence, not its value: `period: null` means 'only when no period is selected', which is a real scope and not the absence of one."
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "type": {
      "type": "object",
      "required": [
        "label",
        "id",
        "props"
      ],
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "description": "Name of the identifying property. Immutable."
        },
        "period": {
          "type": "string",
          "description": "Which property carries the reporting period. One spec then serves every period: the compiler feeds it different leaves instead of the author duplicating nodes."
        },
        "props": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/prop"
          }
        }
      }
    },
    "prop": {
      "type": "object",
      "required": [
        "type",
        "owner"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "string",
            "money",
            "number",
            "date",
            "enum",
            "ref",
            "bool"
          ]
        },
        "owner": {
          "enum": [
            "source",
            "ontology"
          ],
          "description": "Hard rule: never both. Ops may only write owner=ontology."
        },
        "from": {
          "description": "Which raw supplies this property. A list means the figure is corroborated: each source writes it as `<prop>@<raw>` on the row, and the compiler decides what their agreement is worth.",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 2,
              "uniqueItems": true
            }
          ]
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "to": {
          "type": "string",
          "description": "What a ref points at: a declared type name, or 'hook'. A ref to a type is a link — the edge one object follows to another, which is most of what an audit is. A ref to a hook is a gap."
        },
        "nullable": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        },
        "absent": {
          "enum": [
            "gap",
            "zero",
            "none"
          ],
          "description": "What a null means. For a nullable number: 'gap' = not recorded yet (chase it), 'zero' = determined to be none (a finding). For a nullable link: 'gap' = not matched yet, 'none' = determined to have no counterpart. Required, because the two are indistinguishable in the data and opposite in the business."
        },
        "corroboration": {
          "type": "object",
          "additionalProperties": false,
          "description": "Only with a list-valued `from`. A disagreement fails unless the row cites a hook AND `prefer` says which source governs — a preference alone would bury every future disagreement behind it.",
          "properties": {
            "at_least": {
              "type": "integer",
              "minimum": 1,
              "description": "How many of the declared sources must actually have spoken."
            },
            "prefer": {
              "type": "string",
              "description": "Which source governs when they disagree. Never sufficient on its own."
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "owner": {
                "const": "source"
              }
            },
            "required": [
              "owner"
            ]
          },
          "then": {
            "required": [
              "from"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "owner": {
                "const": "ontology"
              }
            },
            "required": [
              "owner"
            ]
          },
          "then": {
            "not": {
              "required": [
                "from"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "enum"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "values"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "nullable": {
                "const": true
              },
              "type": {
                "enum": [
                  "money",
                  "number"
                ]
              }
            },
            "required": [
              "nullable",
              "type"
            ]
          },
          "then": {
            "required": [
              "absent"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "nullable": {
                "const": true
              },
              "type": {
                "const": "ref"
              },
              "to": {
                "not": {
                  "const": "hook"
                }
              }
            },
            "required": [
              "nullable",
              "type",
              "to"
            ]
          },
          "then": {
            "required": [
              "absent"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "ref"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "to"
            ]
          }
        }
      ]
    },
    "raw": {
      "type": "object",
      "required": [
        "label",
        "connector"
      ],
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "connector": {
          "type": "string",
          "description": "One executable command. Values never enter the spec; they are fetched at render time."
        },
        "provides": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "hook": {
      "type": "object",
      "required": [
        "label",
        "resolve_when"
      ],
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "blocked_on": {
          "type": "string",
          "description": "Which raw the gap sits behind."
        },
        "resolve_when": {
          "type": "string",
          "description": "Abstract until this holds; then it lands as a raw or derived node."
        },
        "owner": {
          "type": "string",
          "description": "Who owes the missing material."
        },
        "affects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "node": {
      "type": "object",
      "required": [
        "kind",
        "label"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "raw",
            "hook",
            "derived"
          ]
        },
        "label": {
          "type": "string"
        },
        "op": {
          "type": "string",
          "description": "A restricted SQL subset, parsed by the compiler and never eval'd: `select sum(<prop>) from <Type> [where <cond>]`, `select count(*) from <Type>`, arithmetic over bare node names, and nested aggregates as parenthesised scalar subqueries. No joins, GROUP BY, ORDER BY, LIMIT, DISTINCT, CASE, or other functions."
        },
        "plug_against": {
          "type": "string",
          "description": "This node is a balancing figure; name the independent measure it should agree with."
        },
        "residual_to": {
          "type": "string",
          "description": "Where the divergence from plug_against is registered. A plug with nowhere to put its difference absorbs it silently."
        },
        "because": {
          "type": "string",
          "description": "Names the raw or hook that authorises this node's divergence. Required for every reading the node computes differently under; write because@<reading> per reading, or a bare `because` when every reading shares one — which is what the common two-reading case means."
        },
        "entry": {
          "type": "object",
          "required": [
            "debit",
            "credit"
          ],
          "additionalProperties": false,
          "properties": {
            "debit": {
              "type": "string"
            },
            "credit": {
              "type": "string"
            }
          },
          "description": "Where the derived difference posts. Both sides or neither — half an entry does not balance."
        }
      },
      "if": {
        "properties": {
          "kind": {
            "const": "derived"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "anyOf": [
          {
            "required": [
              "op"
            ]
          },
          {
            "not": {
              "propertyNames": {
                "not": {
                  "pattern": "^op@.+"
                }
              }
            },
            "description": "reads as: at least one property name matches ^op@"
          }
        ]
      },
      "patternProperties": {
        "^(op|because|entry)@.+": {
          "description": "This node's expression, reason, or posting under one declared reading. Overrides the bare key for that reading alone."
        }
      }
    },
    "op": {
      "type": "object",
      "required": [
        "label",
        "class",
        "params",
        "writes",
        "intent"
      ],
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "class": {
          "enum": [
            "DerivedOp",
            "RecordableOp",
            "BlockedOp"
          ],
          "description": "Reversibility tier: who is allowed to land the write."
        },
        "params": {
          "type": "object"
        },
        "writes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Every entry must be an owner=ontology property."
        },
        "intent": {
          "const": "required"
        }
      }
    }
  }
}
